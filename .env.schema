# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true, useCliWithServiceAccount=true, account=my, token=$OP_SERVICE_ACCOUNT_TOKEN)
# @currentEnv=$APP_ENV
# ---
# Only the integration tests read these. They must match the harness API's
# secrets, so the tests run with APP_ENV=ci — the harness default.

# @sensitive @required=false
OP_SERVICE_ACCOUNT_TOKEN=

# @type=enum(dev,ci) @required
APP_ENV=dev

# Auth cookie name (unique per environment to prevent cross-env leakage)
# @required
AUTH_COOKIE=op(op://Paperwall/Development/AUTH_COOKIE)

# JWT signing secret (shared with the API)
# @required @sensitive
JWT_SECRET=op(op://Paperwall/Development/JWT_SECRET)

# Portal-to-API authentication key
# @required @sensitive
PORTAL_API_KEY=op(op://Paperwall/Development/PORTAL_API_KEY)
