{
  "name": "paperwall",
  "version": "0.1.0",
  "description": "Integrate PaperWall into your site or publication",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun build.ts",
    "test:integration": "APP_ENV=ci varlock run -- bun test tests/integration/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "paywall",
    "browser",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@panva/hkdf": "^1.2.1",
    "@types/bun": "latest",
    "@varlock/1password-plugin": "~1.1.0",
    "bun-plugin-dts": "^0.3.0",
    "jose": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "varlock": "^1.2.0"
  }
}